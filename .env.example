# 六合宿主机网关配置。复制为 .env 后修改；真实 Token 不得提交。
# X Cookie 由宿主机 Agent Reach 管理，不要写入本文件。

# 调用方与 Bearer Token 的 JSON 映射；每个 Token 至少 32 个字符且不能复用。
LIUHE_CLIENT_TOKENS={"changfeng":"replace-with-a-random-token-at-least-32-characters"}
# 每个调用方可以使用的平台能力；可选值为 twitter、web、bilibili、xiaohongshu。
LIUHE_CLIENT_SCOPES={"changfeng":["twitter"]}

# Twitter 每次请求最多返回的动态数量；接口每次固定只查询一个账号。
LIUHE_TWITTER_MAX_POSTS_PER_REQUEST=50
# Web 允许读取的域名，多个值用逗号分隔；留空允许任意公开域名，但始终拒绝本机和私有地址。
LIUHE_WEB_ALLOWED_HOSTS=

# 网关仅监听宿主机回环地址，禁止改为公网地址。
LIUHE_BIND_ADDRESS=127.0.0.1
# 网关监听端口；9203 已由落笔坊使用。
LIUHE_PORT=9204
# Python 与 Uvicorn 日志级别，如 debug、info、warning、error。
LIUHE_LOG_LEVEL=info

# 同一用户时间线的内存缓存秒数；设为 0 可关闭缓存。
LIUHE_CACHE_TTL_SECONDS=60
# 所有外部 CLI 和 Jina Reader 请求的最长运行秒数。
LIUHE_PROVIDER_TIMEOUT_SECONDS=90

# Agent Reach 配置文件路径；留空时使用 ~/.agent-reach/config.yaml。
LIUHE_AGENT_REACH_CONFIG_PATH=
# twitter-cli 可执行文件路径；留空时从 PATH 和 ~/.local/bin 自动查找。
LIUHE_TWITTER_COMMAND=
# bili-cli 可执行文件路径；留空时从 PATH 和 ~/.local/bin 自动查找。
LIUHE_BILIBILI_COMMAND=
# OpenCLI 可执行文件路径，用于小红书、B站字幕和 Twitter 浏览器会话回退；留空时从 PATH 自动查找。
LIUHE_OPENCLI_COMMAND=
